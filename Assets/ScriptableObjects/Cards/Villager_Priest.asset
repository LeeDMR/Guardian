  roleType: 2
  portrait: {fileID: 21300000, guid: 4ed45422ac887f741927b2cf594827bf, type: 3}
  portraitTrue: {fileID: 0}
  hasAbility: 1
  description: "\u0421\u043B\u0443\u0436\u0438\u0442\u0435\u043B\u044C \u0445\u0440\u0430\u043C\u0430
    \u0438 \u0437\u0430\u0449\u0438\u0442\u043D\u0438\u043A \u0434\u0435\u0440\u0435\u0432\u043D\u0438.
    \u041E\u043D \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442 \u0447\u0443\u0436\u0443\u044E
    \u0442\u044C\u043C\u0443 \u0438 \u0443\u043A\u0440\u0435\u043F\u043B\u044F\u0435\u0442
    \u0432\u043E\u043B\u044E \u043B\u044E\u0434\u0435\u0439 \u043C\u043E\u043B\u0438\u0442\u0432\u043E\u0439.
    \u0415\u0433\u043E \u0441\u0438\u043B\u0430 \u043D\u0435 \u0432 \u043E\u0440\u0443\u0436\u0438\u0438,
    \u0430 \u0432 \u0432\u0435\u0440\u0435 \u2014 \u0438 \u0438\u043D\u043E\u0433\u0434\u0430
    \u044D\u0442\u043E \u0441\u0438\u043B\u044C\u043D\u0435\u0435 \u043A\u043B\u0438\u043D\u043A\u0430.
    \u0413\u043E\u0432\u043E\u0440\u0438\u0442 \u0435\u0441\u0442\u044C \u043B\u0438
    \u0434\u0435\u043C\u043E\u043D \u0441\u0440\u0435\u0434\u0438 2-\u0443\u0445
    \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u044B\u0445 \u043A\u0430\u0440\u0442."
  abilityButtonText: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C"
  revealDialogue: "\u041D\u0435 \u0431\u043E\u0439\u0442\u0435\u0441\u044C. \u0422\u044C\u043C\u0430
    \u043E\u0442\u0441\u0442\u0443\u043F\u0430\u0435\u0442, \u043A\u043E\u0433\u0434\u0430
    \u0435\u0451 \u043D\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \u043F\u043E \u0438\u043C\u0435\u043D\u0438."
  abilityIntroDialogue: "\u042F \u043F\u0440\u0438\u0437\u043E\u0432\u0443 \u0441\u0432\u0435\u0442.
    \u0415\u0441\u043B\u0438 \u0440\u044F\u0434\u043E\u043C \u0437\u043B\u043E \u2014
    \u043E\u043D\u043E \u0434\u0440\u043E\u0433\u043D\u0435\u0442"
