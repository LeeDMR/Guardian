  hasAbility: 1
  description: "\u041C\u0443\u0434\u0440\u044B\u0439 \u0433\u043B\u0430\u0432\u0430
    \u043E\u0431\u0449\u0438\u043D\u044B. \u041E\u043D \u0437\u043D\u0430\u0435\u0442
    \u0438\u0441\u0442\u043E\u0440\u0438\u0438 \u043A\u0430\u0436\u0434\u043E\u0439
    \u0441\u0435\u043C\u044C\u0438 \u0438 \u043F\u043E\u043C\u043D\u0438\u0442 \u0441\u0442\u0430\u0440\u044B\u0435
    \u0437\u043D\u0430\u043A\u0438. \u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430
    \u0443\u043C\u0435\u0435\u0442 \u0443\u0441\u043F\u043E\u043A\u0430\u0438\u0432\u0430\u0442\u044C
    \u0442\u043E\u043B\u043F\u0443 \u0438 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C
    \u043B\u044E\u0434\u0435\u0439, \u043A\u043E\u0433\u0434\u0430 \u043F\u0430\u043D\u0438\u043A\u0430
    \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u043E\u043F\u0430\u0441\u043D\u0435\u0435
    \u0434\u0435\u043C\u043E\u043D\u043E\u0432. \u041F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442
    \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0435 \u043A\u0430\u0440\u0442\u044B
    \u043D\u0430 \u043D\u0430\u043B\u0438\u0447\u0438\u0435 \u0434\u0435\u043C\u043E\u043D\u0430"
  abilityButtonText: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C"
  revealDialogue: "\u042F \u043F\u0440\u043E\u0436\u0438\u043B \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E,
    \u0447\u0442\u043E\u0431\u044B \u0432\u0438\u0434\u0435\u0442\u044C, \u043A\u0430\u043A
    \u0441\u0442\u0440\u0430\u0445 \u0434\u0435\u043B\u0430\u0435\u0442 \u0432\u0440\u0430\u0433\u043E\u0432
    \u0438\u0437 \u0434\u0440\u0443\u0437\u0435\u0439. \u0414\u0443\u043C\u0430\u0439\u0442\u0435
    \u0433\u043E\u043B\u043E\u0432\u043E\u0439"
  abilityIntroDialogue: "\u0421\u043B\u0443\u0448\u0430\u0439\u0442\u0435 \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E.
    \u0418\u043D\u043E\u0433\u0434\u0430 \u043F\u0440\u0430\u0432\u0434\u0430 \u0441\u043A\u0440\u044B\u0442\u0430
    \u0432 \u043C\u0435\u043B\u043E\u0447\u0430\u0445"
