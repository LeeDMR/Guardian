  hasAbility: 1
  description: "\u0425\u043B\u0430\u0434\u043D\u043E\u043A\u0440\u043E\u0432\u043D\u044B\u0439
    \u0441\u044B\u0449\u0438\u043A, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0438\u0449\u0435\u0442
    \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0440\u0435\u0447\u0438\u044F \u0432
    \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u044F\u0445. \u041E\u043D \u043D\u0435
    \u0432\u0435\u0440\u0438\u0442 \u0441\u043B\u043E\u0432\u0430\u043C \u2014 \u0442\u043E\u043B\u044C\u043A\u043E
    \u0444\u0430\u043A\u0442\u0430\u043C \u0438 \u0440\u0435\u0430\u043A\u0446\u0438\u044F\u043C.
    \u0415\u0441\u043B\u0438 \u0432 \u0434\u0435\u0440\u0435\u0432\u043D\u0435 \u043F\u0440\u044F\u0447\u0435\u0442\u0441\u044F
    \u0434\u0435\u043C\u043E\u043D, \u0434\u0435\u0442\u0435\u043A\u0442\u0438\u0432
    \u043F\u0435\u0440\u0432\u044B\u043C \u0437\u0430\u043C\u0435\u0442\u0438\u0442
    \u0444\u0430\u043B\u044C\u0448\u044C."
  abilityButtonText: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C"
  revealDialogue: "\u0422\u0438\u0445\u043E\u2026 \u042F \u0441\u043B\u044B\u0448\u0443,
    \u043A\u0430\u043A \u043A\u0442\u043E-\u0442\u043E \u0432\u0440\u0451\u0442.
    \u0414\u0430\u0439\u0442\u0435 \u043C\u043D\u0435 \u043C\u0438\u043D\u0443\u0442\u0443
    \u2014 \u0438 \u043C\u0430\u0441\u043A\u0430 \u0441\u043F\u0430\u0434\u0451\u0442"
  abilityIntroDialogue: "\u042F \u0437\u0430\u0434\u0430\u043C \u043E\u0434\u0438\u043D
    \u0432\u043E\u043F\u0440\u043E\u0441. \u041E\u0442\u0432\u0435\u0442 \u043C\u043D\u043E\u0433\u043E\u0435
    \u0440\u0435\u0448\u0438\u0442"
