MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5bfc1f0a0ed2db045bd6c1c53f6f6c29, type: 3}
  m_Name: Level_2
  m_EditorClassIdentifier: Assembly-CSharp::Guardian.Data.LevelDefinition
  levelId: Level_2
  playerLives: 4
  demonsToKill: 3
  cards:
  - cardDefinition: {fileID: 11400000, guid: 7095ef686d074a9ca41914e227c289ef, type: 2}
    trueDefinition: {fileID: 0}
    statementText: "Я видел подозрительные следы возле площади."
    isDemon: 0
  - cardDefinition: {fileID: 11400000, guid: 500b9f1757534b7792b5e4d3267c1321, type: 2}
    trueDefinition: {fileID: 0}
    statementText: "Кто-то врёт... и я знаю, как это проверить."
    isDemon: 0
  - cardDefinition: {fileID: 11400000, guid: 393f80d9f3324fc58968ada000fffd73, type: 2}
    trueDefinition: {fileID: 11400000, guid: a67bbf39eafd49d6876b2e053b4e5b3a, type: 2}
    statementText: "Я просто пёк хлеб всю ночь."
    isDemon: 1
  - cardDefinition: {fileID: 11400000, guid: 03d5a7408f7461947a08cb33713f0108, type: 2}
    trueDefinition: {fileID: 0}
    statementText: "Не все демоны одинаковы. Считайте внимательно."
    isDemon: 0
  - cardDefinition: {fileID: 11400000, guid: 0934b99c270f9a94a86b36f96a606102, type: 2}
    trueDefinition: {fileID: 11400000, guid: cd16deff579049f48fbd84077d458233, type: 2}
    statementText: "Молитва защитит нас... или нет."
    isDemon: 1
  - cardDefinition: {fileID: 11400000, guid: 0b0774ef294797d44960abcac13bfa3c, type: 2}
    trueDefinition: {fileID: 0}
    statementText: "Я не верю словам. Я верю фактам."
    isDemon: 0
  - cardDefinition: {fileID: 11400000, guid: 7095ef686d074a9ca41914e227c289ef, type: 2}
    trueDefinition: {fileID: 11400000, guid: 69da495b9d004795b3473dd8e117099d, type: 2}
    statementText: "Никому нельзя доверять."
    isDemon: 1
  - cardDefinition: {fileID: 11400000, guid: 393f80d9f3324fc58968ada000fffd73, type: 2}
    trueDefinition: {fileID: 0}
    statementText: "Я принёс хлеб всем жителям."
    isDemon: 0
