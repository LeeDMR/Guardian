<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/GuardianHUD.uss?fileID=7433441132597879392&amp;guid=f621e216416ce7b478eae572f2bd632d&amp;type=3#GuardianHUD" />
    <Style src="project://database/Assets/UI/CardTile.uss?fileID=7433441132597879392&amp;guid=f7ed7d2cfd121b148846e11536efc8db&amp;type=3#CardTile" />
    <ui:VisualElement name="Root" picking-mode="Ignore" class="root">
        <ui:VisualElement name="TopBar" class="topbar">
            <ui:VisualElement class="stat">
                <ui:Label text="Lives" class="stat-label" />
                <ui:Label name="LivesValue" text="3" class="stat-value" />
            </ui:VisualElement>
            <ui:VisualElement class="stat">
                <ui:Label text="Demons" class="stat-label" />
                <ui:Label name="DemonsValue" text="2" class="stat-value" />
            </ui:VisualElement>
            <ui:VisualElement class="spacer" />
            <ui:Button name="KillButton" text="Kill" class="btn danger" />
        </ui:VisualElement>
        <ui:VisualElement name="Layout" picking-mode="Ignore" class="layout">
            <ui:VisualElement name="BoardArea" class="board">
                <ui:VisualElement name="CardsGrid" class="cards-grid" />
            </ui:VisualElement>
            <ui:VisualElement name="DetailsPanel" class="details">
                <ui:VisualElement name="Portrait" class="portrait" />
                <ui:Label name="CardTitle" text="Select a card" class="title" />
                <ui:Label name="CardDesc" class="desc" />
                <ui:Button name="AbilityButton" text="Use ability" class="btn" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
