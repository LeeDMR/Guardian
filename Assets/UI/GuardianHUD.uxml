<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/GuardianHUD.uss?fileID=7433441132597879392&amp;guid=f621e216416ce7b478eae572f2bd632d&amp;type=3#GuardianHUD" />
    <Style src="project://database/Assets/UI/CardTile.uss?fileID=7433441132597879392&amp;guid=f7ed7d2cfd121b148846e11536efc8db&amp;type=3#CardTile" />

    <ui:VisualElement name="Root" picking-mode="Ignore" class="root">
        <!-- Gameplay HUD -->
        <ui:VisualElement name="GameHUD" class="game-hud">
            <ui:VisualElement name="TopBar" class="topbar">
                <ui:VisualElement class="stat">
                    <ui:Label text="Lives" class="stat-label" />
                    <ui:Label name="LivesValue" text="3" class="stat-value" />
                </ui:VisualElement>
                <ui:VisualElement class="stat">
                    <ui:Label text="Demons" class="stat-label" />
                    <ui:Label name="DemonsValue" text="2" class="stat-value" />
                </ui:VisualElement>
                <ui:VisualElement class="spacer" />
                <ui:Button name="KillButton" text="Kill" class="btn danger" />
            </ui:VisualElement>

            <ui:VisualElement name="Layout" picking-mode="Ignore" class="layout">
                <ui:VisualElement name="BoardArea" class="board">
                    <ui:VisualElement name="CardsGrid" class="cards-grid" />
                </ui:VisualElement>
                <ui:VisualElement name="DetailsPanel" class="details">
                    <ui:VisualElement name="Portrait" class="portrait" />
                    <ui:Label name="CardTitle" text="Select a card" class="title" />
                    <ui:Label name="CardDesc" class="desc" />
                    <ui:Button name="AbilityButton" text="Use ability" class="btn" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Main Menu -->
        <ui:VisualElement name="MenuOverlay" class="overlay menu-overlay">
            <ui:VisualElement class="overlay-scrim" />
            <ui:VisualElement class="menu-panel">
                <ui:Label text="GUARDIAN" class="menu-title" />
                <ui:Label text="" class="menu-subtitle" />
                <ui:Button name="PlayButton" text="Играть" class="btn primary menu-btn" />
                <ui:Button name="SettingsButton" text="Настройки" class="btn menu-btn" />
                <ui:Button name="ExitButton" text="Выход" class="btn danger menu-btn" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Level Select Modal -->
        <ui:VisualElement name="LevelSelectOverlay" class="overlay modal-overlay hidden">
            <ui:VisualElement class="overlay-scrim" />
            <ui:VisualElement class="modal-panel">
                <ui:Label text="Выбор уровня" class="modal-title" />
                <ui:VisualElement name="LevelsList" class="levels-list" />
                <ui:Button name="LevelsBackButton" text="Назад" class="btn menu-btn" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Settings Modal -->
        <ui:VisualElement name="SettingsOverlay" class="overlay hidden">
          <ui:VisualElement class="panel">
            <ui:Label text="Настройки" class="title"/>

            <ui:Label text="Аудио" class="section"/>
            <ui:VisualElement class="row">
              <ui:Label text="Master" class="row-label"/>
              <ui:SliderInt name="MasterSlider" low-value="0" high-value="100" class="row-control"/>
            </ui:VisualElement>
            <ui:VisualElement class="row">
              <ui:Label text="Music" class="row-label"/>
              <ui:SliderInt name="MusicSlider" low-value="0" high-value="100" class="row-control"/>
            </ui:VisualElement>
            <ui:VisualElement class="row">
              <ui:Label text="SFX" class="row-label"/>
              <ui:SliderInt name="SfxSlider" low-value="0" high-value="100" class="row-control"/>
            </ui:VisualElement>

            <ui:Label text="Графика" class="section"/>
            <ui:VisualElement class="row">
              <ui:Label text="Fullscreen" class="row-label"/>
              <ui:Toggle name="FullscreenToggle" class="row-control"/>
            </ui:VisualElement>
            <ui:VisualElement class="row">
              <ui:Label text="Resolution" class="row-label"/>
              <ui:DropdownField name="ResolutionDropdown" class="row-control"/>
            </ui:VisualElement>
            <ui:VisualElement class="row">
              <ui:Label text="Quality" class="row-label"/>
              <ui:DropdownField name="QualityDropdown" class="row-control"/>
            </ui:VisualElement>
            <ui:VisualElement class="row">
              <ui:Label text="VSync" class="row-label"/>
              <ui:Toggle name="VSyncToggle" class="row-control"/>
            </ui:VisualElement>
            <ui:VisualElement class="row">
              <ui:Label text="FPS" class="row-label"/>
              <ui:DropdownField name="FpsDropdown" class="row-control"/>
            </ui:VisualElement>

            <ui:Label text="Интерфейс" class="section"/>
            <ui:VisualElement class="row">
              <ui:Label text="UI Scale" class="row-label"/>
              <ui:SliderInt name="UIScaleSlider" low-value="80" high-value="130" class="row-control"/>
            </ui:VisualElement>

            <ui:VisualElement class="buttons">
              <ui:Button name="SettingsBackButton" text="Назад"/>
              <ui:Button name="SettingsResetButton" text="Сбросить"/>
            </ui:VisualElement>
          </ui:VisualElement>
        </ui:VisualElement>
    
    <!-- Outcome overlays -->
    <ui:VisualElement name="WinOverlay" class="overlay hidden">
        <ui:VisualElement class="overlay-scrim" />
        <ui:VisualElement class="modal-panel outcome-panel">
            <ui:Label text="Победа!" class="outcome-title win" />
            <ui:Label name="WinDesc" text="Все демоны изгнаны." class="outcome-desc" />
            <ui:VisualElement class="outcome-buttons">
                <ui:Button name="WinRestartButton" text="Заново" class="btn primary menu-btn" />
                <ui:Button name="WinMenuButton" text="В меню" class="btn menu-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="LoseOverlay" class="overlay hidden">
        <ui:VisualElement class="overlay-scrim" />
        <ui:VisualElement class="modal-panel outcome-panel">
            <ui:Label text="Поражение" class="outcome-title lose" />
            <ui:Label name="LoseDesc" text="У вас закончились жизни." class="outcome-desc" />
            <ui:VisualElement class="outcome-buttons">
                <ui:Button name="LoseRestartButton" text="Попробовать снова" class="btn primary menu-btn" />
                <ui:Button name="LoseMenuButton" text="В меню" class="btn menu-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:VisualElement>
</ui:UXML>
