<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/GuardianHUD.uss?fileID=7433441132597879392&amp;guid=f621e216416ce7b478eae572f2bd632d&amp;type=3#GuardianHUD" />
    <Style src="project://database/Assets/UI/CardTile.uss?fileID=7433441132597879392&amp;guid=f7ed7d2cfd121b148846e11536efc8db&amp;type=3#CardTile" />

    <ui:VisualElement name="Root" picking-mode="Ignore" class="root">
        <!-- Gameplay HUD -->
        <ui:VisualElement name="GameHUD" class="game-hud">
            <ui:VisualElement name="TopBar" class="topbar">
                <ui:VisualElement class="stat">
                    <ui:Label text="Lives" class="stat-label" />
                    <ui:Label name="LivesValue" text="3" class="stat-value" />
                </ui:VisualElement>
                <ui:VisualElement class="stat">
                    <ui:Label text="Demons" class="stat-label" />
                    <ui:Label name="DemonsValue" text="2" class="stat-value" />
                </ui:VisualElement>
                <ui:VisualElement class="spacer" />
                <ui:Button name="KillButton" text="Kill" class="btn danger" />
            </ui:VisualElement>

            <ui:VisualElement name="Layout" picking-mode="Ignore" class="layout">
                <ui:VisualElement name="BoardArea" class="board">
                    <ui:VisualElement name="CardsGrid" class="cards-grid" />
                </ui:VisualElement>
                <ui:VisualElement name="DetailsPanel" class="details">
                    <ui:VisualElement name="Portrait" class="portrait" />
                    <ui:Label name="CardTitle" text="Select a card" class="title" />
                    <ui:Label name="CardDesc" class="desc" />
                    <ui:Button name="AbilityButton" text="Use ability" class="btn" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Main Menu -->
        <ui:VisualElement name="MenuOverlay" class="overlay menu-overlay">
            <ui:VisualElement class="overlay-scrim" />
            <ui:VisualElement class="menu-panel">
                <ui:Label text="GUARDIAN" class="menu-title" />
                <ui:Label text="" class="menu-subtitle" />
                <ui:Button name="PlayButton" text="Играть" class="btn primary menu-btn" />
                <ui:Button name="SettingsButton" text="Настройки" class="btn menu-btn" />
                <ui:Button name="ExitButton" text="Выход" class="btn danger menu-btn" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Level Select Modal -->
        <ui:VisualElement name="LevelSelectOverlay" class="overlay modal-overlay hidden">
            <ui:VisualElement class="overlay-scrim" />
            <ui:VisualElement class="modal-panel">
                <ui:Label text="Выбор уровня" class="modal-title" />
                <ui:VisualElement name="LevelsList" class="levels-list" />
                <ui:Button name="LevelsBackButton" text="Назад" class="btn menu-btn" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Settings Modal -->
        <ui:VisualElement name="SettingsOverlay" class="overlay modal-overlay hidden">
            <ui:VisualElement class="overlay-scrim" />
            <ui:VisualElement class="modal-panel">
                <ui:Label text="Настройки" class="modal-title" />
                <ui:VisualElement class="settings-row">
                    <ui:Label text="Музыка" class="settings-label" />
                    <ui:Slider name="MusicSlider" low-value="0" high-value="1" value="0.8" class="settings-slider" />
                </ui:VisualElement>
                <ui:VisualElement class="settings-row">
                    <ui:Label text="SFX" class="settings-label" />
                    <ui:Slider name="SfxSlider" low-value="0" high-value="1" value="0.8" class="settings-slider" />
                </ui:VisualElement>
                <ui:Button name="SettingsBackButton" text="Закрыть" class="btn menu-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
