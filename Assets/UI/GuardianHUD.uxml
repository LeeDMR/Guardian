<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/GuardianHUD.uss?fileID=7433441132597879392&amp;guid=f621e216416ce7b478eae572f2bd632d&amp;type=3#GuardianHUD" />
    <Style src="project://database/Assets/UI/CardTile.uss?fileID=7433441132597879392&amp;guid=f7ed7d2cfd121b148846e11536efc8db&amp;type=3#CardTile" />

    <ui:VisualElement name="Root" picking-mode="Ignore" class="root">
        <!-- Gameplay HUD -->
        <ui:VisualElement name="GameHUD" class="game-hud">
            <ui:VisualElement name="TopBar" class="topbar">
                <ui:VisualElement class="stat">
                    <ui:Label text="Lives" class="stat-label" />
                    <ui:Label name="LivesValue" text="3" class="stat-value" />
                </ui:VisualElement>
                <ui:VisualElement class="stat">
                    <ui:Label text="Demons" class="stat-label" />
                    <ui:Label name="DemonsValue" text="2" class="stat-value" />
                </ui:VisualElement>
                <ui:VisualElement class="spacer" />
                <ui:Button name="KillButton" text="Kill" class="btn danger" />
            </ui:VisualElement>

            <ui:VisualElement name="Layout" picking-mode="Ignore" class="layout">
                <ui:VisualElement name="BoardArea" class="board">
                    <ui:VisualElement name="CardsGrid" class="cards-grid" />
                </ui:VisualElement>
                <ui:VisualElement name="DetailsPanel" class="details">
                    <ui:VisualElement name="Portrait" class="portrait" />
                    <ui:Label name="CardTitle" text="Select a card" class="title" />
                    <ui:Label name="CardDesc" class="desc" />
                    <ui:Button name="AbilityButton" text="Use ability" class="btn" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Main Menu -->
        <ui:VisualElement name="MenuOverlay" class="overlay menu-overlay">
            <ui:VisualElement class="overlay-scrim" />
            <ui:VisualElement class="menu-panel">
                <ui:Label text="GUARDIAN" class="menu-title" />
                <ui:Label text="" class="menu-subtitle" />
                <ui:Button name="PlayButton" text="Играть" class="btn primary menu-btn" />
                <ui:Button name="SettingsButton" text="Настройки" class="btn menu-btn" />
                <ui:Button name="ExitButton" text="Выход" class="btn danger menu-btn" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Level Select Modal -->
        <ui:VisualElement name="LevelSelectOverlay" class="overlay modal-overlay hidden">
            <ui:VisualElement class="overlay-scrim" />
            <ui:VisualElement class="modal-panel">
                <ui:Label text="Выбор уровня" class="modal-title" />
                <ui:VisualElement name="LevelsList" class="levels-list" />
                <ui:Button name="LevelsBackButton" text="Назад" class="btn menu-btn" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Settings Modal -->
        <ui:VisualElement name="SettingsOverlay" class="overlay hidden">
          <ui:VisualElement class="modal settings-modal">

            <!-- Header -->
            <ui:VisualElement class="modal-header">
              <ui:Label text="Настройки" class="modal-title"/>
              <ui:Button name="SettingsCloseX" text="✕" class="icon-btn"/>
            </ui:VisualElement>

            <!-- Tabs -->
            <ui:VisualElement class="tabs">
              <ui:Button name="TabAudio" text="Аудио" class="tab is-active"/>
              <ui:Button name="TabGraphics" text="Графика" class="tab"/>
              <ui:Button name="TabUI" text="Интерфейс" class="tab"/>
            </ui:VisualElement>

            <!-- Body -->
            <ui:ScrollView class="modal-body">
              <!-- AUDIO -->
              <ui:VisualElement name="Settings_Audio" class="tab-page">
                <ui:VisualElement class="setting-row">
                  <ui:Label text="Master" class="setting-label"/>
                  <ui:SliderInt name="MasterSlider" low-value="0" high-value="100" class="setting-control"/>
                  <ui:Label name="MasterValue" text="100%" class="setting-value"/>
                </ui:VisualElement>

                <ui:VisualElement class="setting-row">
                  <ui:Label text="Music" class="setting-label"/>
                  <ui:SliderInt name="MusicSlider" low-value="0" high-value="100" class="setting-control"/>
                  <ui:Label name="MusicValue" text="100%" class="setting-value"/>
                </ui:VisualElement>

                <ui:VisualElement class="setting-row">
                  <ui:Label text="SFX" class="setting-label"/>
                  <ui:SliderInt name="SfxSlider" low-value="0" high-value="100" class="setting-control"/>
                  <ui:Label name="SfxValue" text="100%" class="setting-value"/>
                </ui:VisualElement>
              </ui:VisualElement>

              <!-- GRAPHICS -->
              <ui:VisualElement name="Settings_Graphics" class="tab-page hidden">
                <ui:VisualElement class="setting-row">
                  <ui:Label text="Fullscreen" class="setting-label"/>
                  <ui:Toggle name="FullscreenToggle" class="toggle"/>
                </ui:VisualElement>

                <ui:VisualElement class="setting-row">
                  <ui:Label text="Resolution" class="setting-label"/>
                  <ui:DropdownField name="ResolutionDropdown" class="dropdown"/>
                </ui:VisualElement>

                <ui:VisualElement class="setting-row">
                  <ui:Label text="Quality" class="setting-label"/>
                  <ui:DropdownField name="QualityDropdown" class="dropdown"/>
                </ui:VisualElement>

                <ui:VisualElement class="setting-row">
                  <ui:Label text="VSync" class="setting-label"/>
                  <ui:Toggle name="VSyncToggle" class="toggle"/>
                </ui:VisualElement>

                <ui:VisualElement class="setting-row">
                  <ui:Label text="FPS" class="setting-label"/>
                  <ui:DropdownField name="FpsDropdown" class="dropdown"/>
                </ui:VisualElement>
              </ui:VisualElement>

              <!-- UI -->
              <ui:VisualElement name="Settings_UI" class="tab-page hidden">
                <ui:VisualElement class="setting-row">
                  <ui:Label text="UI Scale" class="setting-label"/>
                  <ui:SliderInt name="UIScaleSlider" low-value="80" high-value="130" class="setting-control"/>
                  <ui:Label name="UIScaleValue" text="100%" class="setting-value"/>
                </ui:VisualElement>
              </ui:VisualElement>
            </ui:ScrollView>

            <!-- Footer -->
            <ui:VisualElement class="modal-footer">
              <ui:Button name="SettingsBackButton" text="Назад" class="btn secondary"/>
              <ui:Button name="SettingsResetButton" text="Сбросить" class="btn danger"/>
            </ui:VisualElement>

          </ui:VisualElement>
        </ui:VisualElement>

                <!-- Victory -->
        <ui:VisualElement name="VictoryOverlay" class="overlay hidden">
          <ui:VisualElement class="modal win-modal">
            <ui:Label text="ПОБЕДА" class="result-title"/>
            <ui:Label name="VictorySubtitle" text="Вы изгнали всех демонов!" class="result-subtitle"/>

            <ui:VisualElement class="result-buttons">
              <ui:Button name="VictoryRestartButton" text="Заново" class="btn"/>
              <ui:Button name="VictoryMenuButton" text="В меню" class="btn secondary"/>
            </ui:VisualElement>
          </ui:VisualElement>
        </ui:VisualElement>

        <!-- Defeat -->
        <ui:VisualElement name="DefeatOverlay" class="overlay hidden">
          <ui:VisualElement class="modal lose-modal">
            <ui:Label text="ПОРАЖЕНИЕ" class="result-title"/>
            <ui:Label name="DefeatSubtitle" text="Жизни закончились." class="result-subtitle"/>

            <ui:VisualElement class="result-buttons">
              <ui:Button name="DefeatRestartButton" text="Заново" class="btn"/>
              <ui:Button name="DefeatMenuButton" text="В меню" class="btn secondary"/>
            </ui:VisualElement>
          </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
