<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="GuardianHUD.uss" />

    <!-- Root ignores picking so it won't block UGUI cards -->
    <ui:VisualElement name="Root" class="root" picking-mode="Ignore">

        <ui:VisualElement name="TopBar" class="topbar" picking-mode="Position">
            <ui:VisualElement class="stat">
                <ui:Label text="Lives" class="stat-label"/>
                <ui:Label name="LivesValue" text="3" class="stat-value"/>
            </ui:VisualElement>

            <ui:VisualElement class="stat">
                <ui:Label text="Demons" class="stat-label"/>
                <ui:Label name="DemonsValue" text="2" class="stat-value"/>
            </ui:VisualElement>

            <ui:VisualElement class="spacer"/>
            <ui:Button name="KillButton" text="Kill" class="btn danger"/>
        </ui:VisualElement>

        <ui:VisualElement name="Layout" class="layout">
            <ui:VisualElement name="BoardArea" class="board" picking-mode="Ignore"/>

            <ui:VisualElement name="DetailsPanel" class="details" picking-mode="Position">
                <ui:VisualElement name="Portrait" class="portrait"/>
                <ui:Label name="CardTitle" text="Select a card" class="title"/>
                <ui:Label name="CardDesc" text="" class="desc"/>
                <ui:Button name="AbilityButton" text="Use ability" class="btn"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
