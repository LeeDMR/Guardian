.root {
    width: 100%;
    height: 100%;
    background-color: rgba(15, 16, 18, 0.0);
}

.topbar {
    position: absolute;
    left: 24px;
    right: 24px;
    top: 18px;
    /*
      Keep the bar compact.
      Stats are rendered on a single row now (label left, value right),
      so we don't need the extra height.
    */
    height: 72px;

    flex-direction: row;
    align-items: center;
    gap: 12px;

    padding-left: 16px;
    padding-right: 16px;
    padding-top: 8px;
    padding-bottom: 8px;

    background-color: rgba(35, 38, 44, 0.90);
    border-radius: 16px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255,255,255,0.08);
    border-right-color: rgba(255,255,255,0.08);
    border-top-color: rgba(255,255,255,0.08);
    border-bottom-color: rgba(255,255,255,0.08);

    /* Safety: never let inner chips render outside the bar */
    overflow: hidden;
}

.stat {
    /* label (left) + value (right) on one line */
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 10px;

    padding-left: 16px;
    padding-right: 16px;
    padding-top: 8px;
    padding-bottom: 8px;

    background-color: rgba(255,255,255,0.06);
    border-radius: 16px;
    min-width: 170px;
}

.stat-label {
    color: rgba(255,255,255,0.70);
    font-size: 14px;
    -unity-text-align: middle-left;
    flex-grow: 1;
}

.stat-value {
    color: white;
    /* bigger, but still fits because it's on the same row */
    font-size: 32px;
    unity-font-style: bold;
    -unity-text-align: middle-right;
}

.spacer {
    flex-grow: 1;
}

.layout {
    position: absolute;
    left: 24px;
    right: 24px;
    /* below the topbar (18 + 72 + ~14 gap) */
    top: 104px;
    bottom: 24px;

    flex-direction: row;
    gap: 18px;
}

.board {
    flex-grow: 1;
    background-color: rgba(0,0,0,0);   /* fully transparent */
    border-radius: 18px;

    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255,255,255,0.08);
    border-right-color: rgba(255,255,255,0.08);
    border-top-color: rgba(255,255,255,0.08);
    border-bottom-color: rgba(255,255,255,0.08);
}


.details {
    width: 380px;
    height: 100%;
    padding: 16px;
    gap: 12px;

    background-color: rgba(35, 38, 44, 0.90);
    border-radius: 18px;

    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255,255,255,0.08);
    border-right-color: rgba(255,255,255,0.08);
    border-top-color: rgba(255,255,255,0.08);
    border-bottom-color: rgba(255,255,255,0.08);
}

.portrait {
    height: 220px;
    border-radius: 16px;
    background-color: rgba(255,255,255,0.06);
}

.title {
    color: white;
    font-size: 18px;
    unity-font-style: bold;
}

.desc {
    color: rgba(255,255,255,0.75);
    font-size: 13px;
    white-space: normal;
    flex-grow: 1;
}

.btn {
    height: 48px;
    border-radius: 14px;
    padding-left: 18px;
    padding-right: 18px;
    background-color: rgba(255,255,255,0.10);
    color: white;
}

/* Button text sizing (UI Toolkit stores the text in an inner label) */
.btn .unity-button__text,
.btn .unity-text-element {
    font-size: 15px;
    unity-font-style: bold;
}

/* Top bar CTA should be a bit bigger */
.topbar .btn {
    height: 52px;
    border-radius: 16px;
    min-width: 110px;
}

.topbar .btn .unity-button__text,
.topbar .btn .unity-text-element {
    font-size: 18px;
}

.btn:hover {
    background-color: rgba(255,255,255,0.16);
}

.btn:active {
    background-color: rgba(255,255,255,0.20);
}

.btn:disabled {
    opacity: 0.45;
}

.danger {
    background-color: rgba(220, 65, 65, 0.95);
}
.danger:hover {
    background-color: rgba(240, 85, 85, 0.95);
}
.danger.active {
    background-color: rgba(160,160,160,0.95);
}

/* ===== Details panel show/hide without layout shift ===== */
.details {
    /* hidden by default (no clicks; keeps its column size) */
    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    /* UI Toolkit uses translate/rotate/scale instead of CSS "transform" */
    translate: 8px 0px;

    /* Keep transitions simple for runtime stability */
    transition-property: opacity;
    transition-duration: 180ms;
}

.details.shown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    translate: 0px 0px;
}

/* ===== Speech bubble (UI Toolkit) ===== */
.speech {
    position: absolute;
    z-index: 20;
    max-width: 320px;

    padding: 10px 12px;
    border-radius: 14px;

    background-color: rgba(0,0,0,0.75);
    color: white;

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    translate: 0px 6px;
    /* Keep transitions simple for runtime stability */
    transition-property: opacity;
    transition-duration: 150ms;
}

.speech.shown {
    opacity: 1;
    visibility: visible;
    translate: 0px 0px;
}

.speech.hidden {
    opacity: 0;
    visibility: hidden;
    translate: 0px 6px;
}

.speech__text {
    white-space: normal;
    font-size: 13px;
}

/* =====================
   Main Menu / Modals
   ===================== */

.game-hud {
    width: 100%;
    height: 100%;
}

.hidden {
    display: none;
}

.overlay {
    position: absolute;
    left: 0px;
    right: 0px;
    top: 0px;
    bottom: 0px;
    justify-content: center;
    align-items: center;
}

.overlay-scrim {
    position: absolute;
    left: 0px;
    right: 0px;
    top: 0px;
    bottom: 0px;
    background-color: rgba(10, 11, 13, 0.72);
}

.menu-panel,
.modal-panel {
    z-index: 50;
    width: 460px;
    padding: 26px;
    gap: 14px;
    flex-direction: column;

    background-color: rgba(35, 38, 44, 0.92);
    border-radius: 22px;

    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255,255,255,0.10);
    border-right-color: rgba(255,255,255,0.10);
    border-top-color: rgba(255,255,255,0.10);
    border-bottom-color: rgba(255,255,255,0.10);
}

.menu-title {
    color: white;
    font-size: 34px;
    unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 2px;
}

.menu-subtitle {
    color: rgba(255,255,255,0.65);
    font-size: 14px;
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

.modal-title {
    color: white;
    font-size: 22px;
    unity-font-style: bold;
    -unity-text-align: middle-left;
    margin-bottom: 6px;
}

.menu-btn {
    height: 56px;
    border-radius: 16px;
}

.menu-btn .unity-button__text,
.menu-btn .unity-text-element {
    font-size: 18px;
    unity-font-style: bold;
}

.primary {
    background-color: rgba(70, 140, 255, 0.92);
}
.primary:hover {
    background-color: rgba(95, 165, 255, 0.96);
}
.primary:active {
    background-color: rgba(55, 120, 230, 0.96);
}

.levels-list {
    flex-direction: column;
    gap: 10px;
    max-height: 320px;
    overflow: scroll;
    padding-right: 4px;
}

.settings-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 6px;
    padding-bottom: 6px;
}

.settings-label {
    color: rgba(255,255,255,0.80);
    font-size: 14px;
}

.settings-slider {
    width: 220px;
}

.section {
  margin-top: 14px;
  margin-bottom: 6px;
  unity-font-style: bold;
  font-size: 14px;
  color: rgba(255,255,255,0.85);
}

.row {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-top: 6px;
  margin-bottom: 6px;
}

.row-label {
  width: 140px;
  color: rgba(255,255,255,0.75);
  font-size: 13px;
}

.row-control {
  flex-grow: 1;
}

.buttons {
  flex-direction: row;
  justify-content: space-between;
  margin-top: 16px;
}

/* =============================
   Win / Lose overlays
   ============================= */

.overlay-scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
}

.outcome-panel {
    width: 520px;
    padding: 22px 22px;
    border-radius: 16px;
    background-color: rgba(44, 48, 52, 0.95);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.10);
    align-items: center;
}

.outcome-title {
    font-size: 34px;
    unity-font-style: bold;
    margin-bottom: 6px;
}

.outcome-title.win { color: rgb(190, 255, 190); }
.outcome-title.lose { color: rgb(255, 190, 190); }

.outcome-desc {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 18px;
    unity-text-align: middle-center;
}

.outcome-buttons {
    flex-direction: row;
    gap: 12px;
}
