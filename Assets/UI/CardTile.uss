.cards-grid {
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: center;
  align-content: center;

  gap: 24px;
  padding: 28px;
}

.card {
  width: 240px;
  height: 340px;

  background-color: rgba(255,255,255,0.06);
  border-radius: 18px;

  border-left-width: 1px;
  border-right-width: 1px;
  border-top-width: 1px;
  border-bottom-width: 1px;
  border-left-color: rgba(255,255,255,0.10);
  border-right-color: rgba(255,255,255,0.10);
  border-top-color: rgba(255,255,255,0.10);
  border-bottom-color: rgba(255,255,255,0.10);
}

.card:hover {
  background-color: rgba(255,255,255,0.10);
}

.card.selected {
  border-left-color: rgba(120,190,255,0.9);
  border-right-color: rgba(120,190,255,0.9);
  border-top-color: rgba(120,190,255,0.9);
  border-bottom-color: rgba(120,190,255,0.9);
}

.card.kill {
  border-left-color: rgba(240,80,80,0.95);
  border-right-color: rgba(240,80,80,0.95);
  border-top-color: rgba(240,80,80,0.95);
  border-bottom-color: rgba(240,80,80,0.95);
}

.card.dead {
  opacity: 0.35;
}

.card-face-down,
.card-face-up {
  width: 100%;
  height: 100%;
  padding: 16px;
}

.card-face-up {
  display: none;
}

.card.open .card-face-down { display: none; }
.card.open .card-face-up { display: flex; flex-direction: column; gap: 12px; }

.card-portrait {
  height: 220px;
  border-radius: 14px;
  background-color: rgba(255,255,255,0.08);
}

.card-title {
  color: white;
  unity-font-style: bold;
  font-size: 16px;
}

.card-number {
  position: absolute;
  bottom: 12px;
  left: 0px;
  right: 0px;
  text-align: center;
  color: rgba(255,255,255,0.85);
  unity-font-style: bold;
  font-size: 18px;
}

.card-unknown {
  color: rgba(255,255,255,0.85);
  unity-font-style: bold;
  font-size: 18px;
  text-align: center;
  margin-top: 10px;
}
